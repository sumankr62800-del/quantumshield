
# ============================================================
# QUANTUMSHIELD ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================

# Application
APP_NAME=QuantumShield
APP_VERSION=0.1.0
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./quantumshield.db

# JWT Authentication
SECRET_KEY=replace-with-your-own-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256 Encryption
# Generate a secure random 32-byte key (64 hexadecimal characters).
MESSAGE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# CORS
# Replace with the actual frontend origin for deployment.
CORS_ORIGINS=http://localhost:3000
