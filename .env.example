
# ============================================================
# QUANTUMSHIELD ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================

# Application
APP_NAME=QuantumShield
APP_VERSION=0.1.0
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./quantumshield.db

# JWT Authentication
SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256 Encryption
# Generate a secure random 32-byte key (64 hexadecimal characters).
MESSAGE_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_32_BYTE_ENCRYPTION_KEY

# CORS
# Replace with the actual frontend origin for deployment.
CORS_ORIGINS=http://localhost:3000
